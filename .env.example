# Backend
GOOGLE_TTS_API_KEY=
GOOGLE_TRANSLATE_API_KEY=
DATABASE_CONNECTION_LIMIT=2
DATABASE_POOL_TIMEOUT_SECONDS=30
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SERVICE_ACCOUNT_JSON=
KHAYA_API_KEY=
KHAYA_SUBSCRIPTION_KEY=
GHANANLP_API_KEY=
GHANANLP_SUBSCRIPTION_KEY=
KHAYA_SUBSCRIPTION_HEADER=Ocp-Apim-Subscription-Key
KHAYA_TTS_SPEAKER_ID=male_low
KHAYA_TTS_URL=https://translation-api.ghananlp.org/tts/v2/synthesize
KHAYA_AUDIO_ALLOWED_ORIGINS=
KHAYA_AUDIO_MAX_BYTES=16777216
KHAYA_TOTAL_AUDIO_MAX_BYTES=67108864
KHAYA_TTS_PAUSE_MS=180
# Optional JSON object with all/en/tw/ee/gaa pronunciation maps.
PRONUNCIATION_DICTIONARY_JSON=
KHAYA_TRANSLATE_URL=https://translation-api.ghananlp.org/v2/translate
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Gemini TTS reuses GEMINI_API_KEY. Provider "gemini" is Premium; "gemini-lite" is available on all plans.
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_LITE_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_TIMEOUT_MS=45000
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
DATABASE_URL="postgresql://readmate:readmate@localhost:5432/readmate"
DATABASE_APP_ROLE=readmate_api
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=readmate-uploads
PORT=8787
# Exact origins only. Keep the Chrome extension and authenticated Expo web app
# separate so production CORS can fail closed without accepting broad patterns.
EXTENSION_ORIGIN=chrome-extension://your-extension-id
WEB_APP_ORIGIN=https://app.readmate.example
ALLOW_ANONYMOUS_TTS=false
CRON_SECRET=
# Backend-only stable HMAC key for privacy-safe WebMCP audit digests.
# Use at least 32 random characters; never expose it as EXPO_PUBLIC_*.
WEBMCP_AUDIT_DIGEST_KEY=
OUTBOUND_REQUEST_TIMEOUT_MS=15000
DOCUMENT_PROCESSING_CONCURRENCY=2
TTS_DAILY_CHAR_LIMIT=500000
FREE_TTS_DAILY_CHAR_LIMIT=25000
PREMIUM_TTS_DAILY_CHAR_LIMIT=500000
# Optional comma-separated Clerk user IDs for controlled manual Premium support grants.
READMATE_PREMIUM_USER_IDS=
# Backend-only RevenueCat secret API key. Never use an appl_/goog_ client SDK key here or expose this as EXPO_PUBLIC_*.
REVENUECAT_SECRET_API_KEY=
# RevenueCat entitlement identifier shared by the Apple and Google subscription products.
REVENUECAT_ENTITLEMENT_ID=premium
FREE_MAX_UPLOAD_BYTES=10485760
FREE_MAX_DOCUMENT_CHARACTERS=100000
FREE_MAX_PDF_PAGES=50
PREMIUM_MAX_UPLOAD_BYTES=52428800
PREMIUM_MAX_DOCUMENT_CHARACTERS=10000000
PREMIUM_MAX_PDF_PAGES=2000
AI_DAILY_INPUT_CHAR_LIMIT=250000
UPLOAD_DAILY_BYTE_LIMIT=209715200
UPLOAD_TOTAL_BYTE_LIMIT=1073741824
UPLOAD_TOTAL_OBJECT_LIMIT=1000
UPLOAD_PENDING_OBJECT_LIMIT=20
ENABLE_RSS_REFRESH_WORKER=false
RSS_REFRESH_INTERVAL_MINUTES=30
SUPABASE_MEDIA_BUCKET=readmate-media
SUPABASE_MEDIA_SIGNED_URL_TTL_SECONDS=86400

# Extension side panel setting defaults to http://localhost:8787.
# Paste a Clerk session token in the MVP side panel for local testing, or replace
# apps/extension/src/auth/authClient.ts with @clerk/chrome-extension sign-in UI.

# Mobile
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_READMATE_API_URL=http://localhost:8787
