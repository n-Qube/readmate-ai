{
  "name": "@readmate/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "validate:web-deployment": "node scripts/validate-web-deployment.cjs",
    "export:web": "node scripts/export-web.cjs",
    "prepare:firebase-hosting": "node scripts/prepare-firebase-hosting.cjs",
    "validate:firebase-hosting": "node scripts/validate-firebase-hosting.cjs",
    "validate:firebase-hosting-release": "node scripts/firebase-hosting-release-guard.cjs --check-only",
    "hash:firebase-hosting": "node scripts/firebase-hosting-release-guard.cjs --print-artifact-sha256",
    "export:web:firebase": "npm run export:web && npm run prepare:firebase-hosting && npm run validate:firebase-hosting",
    "deploy:firebase-hosting:guarded": "node scripts/firebase-hosting-release-guard.cjs --deploy",
    "test:firebase-hosting": "node --test scripts/firebase-hosting-adapter.node-test.cjs scripts/firebase-hosting-release-guard.node-test.cjs",
    "test:firebase-hosting:emulator": "node scripts/firebase-hosting-emulator.cjs",
    "test": "vitest run && npm run test:firebase-hosting",
    "typecheck": "tsc --noEmit",
    "validate:public-ui": "node scripts/validate-public-ui.cjs",
    "validate:brand": "node scripts/validate-brand-consistency.cjs",
    "validate:ios-native-modules": "node scripts/validate-ios-native-modules.cjs",
    "validate:playback-capabilities": "node scripts/validate-playback-capabilities.cjs",
    "eas-build-post-install": "npm run validate:public-ui && npm run validate:brand && npm run validate:ios-native-modules && npm run validate:playback-capabilities",
    "build:internal:android": "eas build -p android --profile store-internal",
    "build:internal:ios": "eas build -p ios --profile store-internal",
    "submit:internal:android": "eas submit -p android --profile internal",
    "submit:internal:ios": "eas submit -p ios --profile internal"
  },
  "dependencies": {
    "@clerk/expo": "^3.7.8",
    "@expo/ui": "~56.0.18",
    "@expo/vector-icons": "^15.0.2",
    "@tanstack/react-query": "^5.100.11",
    "expo": "~56.0.8",
    "expo-apple-authentication": "~56.0.4",
    "expo-asset": "~56.0.15",
    "expo-audio": "~56.0.11",
    "expo-auth-session": "~56.0.13",
    "expo-constants": "~56.0.16",
    "expo-crypto": "~56.0.5",
    "expo-document-picker": "~56.0.4",
    "expo-file-system": "~56.0.7",
    "expo-font": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-linking": "~56.0.13",
    "expo-router": "~56.2.8",
    "expo-secure-store": "~56.0.4",
    "expo-share-intent": "7.0.0",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.6",
    "expo-system-ui": "~56.0.5",
    "expo-web-browser": "~56.0.5",
    "expo-widgets": "^56.0.19",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-purchases": "^10.8.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.8.3",
    "readmate-airplay": "file:./modules/readmate-airplay"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
