{
  "hosting": {
    "target": "readmate-web",
    "public": "dist/firebase-hosting",
    "ignore": [
      "firebase.web.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Origin-Agent-Cluster",
            "value": "?1"
          },
          {
            "key": "Permissions-Policy",
            "value": "tools=(self)"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/document/*",
        "destination": "/_firebase_routes/document.html"
      }
    ]
  }
}
