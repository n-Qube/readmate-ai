{
  "name": "@readmate/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prebuild": "prisma generate",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "refresh:rss": "tsx src/jobs/refreshRssFeeds.ts",
    "pretypecheck": "prisma generate",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "test:pg": "vitest run src/integration"
  },
  "dependencies": {
    "@clerk/backend": "^2.33.5",
    "@clerk/express": "^1.3.30",
    "@prisma/client": "^6.1.0",
    "@supabase/supabase-js": "^2.106.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "jszip": "^3.10.1",
    "pdfjs-dist": "^4.10.38",
    "sharp": "^0.35.4",
    "sherpa-onnx-node": "1.13.6",
    "word-extractor": "^1.0.4",
    "ws": "^8.20.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.18.1",
    "prisma": "^6.1.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
}
